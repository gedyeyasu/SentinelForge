# Copy this file to .env and fill values locally. Never commit .env.
# See README.md Configuration section and docs/HIDDENLAYER_TRACK3.md for Track 3

# Cloud persistence (optional, SQLite used locally if not set)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DB_STRING=

# NVIDIA NIM (primary stable inference)
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# vLLM local performance path (optional, falls back to NIM)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=nvidia/nemotron-3-nano-30b-a3b
VLLM_API_KEY=not-needed

# GitHub integration - Option 1: Manual Token (simple)
GITHUB_TOKEN=
# GitHub integration - Option 2: OAuth (super cool, one-click connect, no copy-paste)
# Create OAuth App at https://github.com/settings/developers -> OAuth Apps -> New OAuth App
# Set Authorization callback URL to http://localhost:8741/api/github/oauth/callback
# Then fill client ID and secret here, restart API, and click Connect with GitHub in WebUI
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8741/api/github/oauth/callback
GITHUB_OAUTH_SCOPE=repo,read:org,read:user

# HiddenLayer Track 3 - Runtime Security v2 (preferred, from event landing page)
# Event Landing: https://aitx-key-vendor.redpond-27dfd1c6.eastus.azurecontainerapps.io/
# Event Code: AITX-2026
# Mint keys via vendor page, then fill here
HIDDENLAYER_CLIENT_ID=
HIDDENLAYER_CLIENT_SECRET=
HL_PROJECT_ID=
# Legacy v1 API key (fallback if v2 not configured)
HIDDENLAYER_API_KEY=
HIDDENLAYER_BASE_URL=https://api.hiddenlayer.ai

# OpenShell policy enforcement
OPENSHELL_POLICY_PATH=config/openshell-policy.yaml

# SentinelForge local config
SENTINELFORGE_ALLOWED_ROOTS=
SENTINELFORGE_DB_PATH=.sentinelforge/control.db

# Red Hat Security Data (public, no key needed)
# Uses https://access.redhat.com/hydra/rest/securitydata/casf.json and oval.json

